# Generate private secrets using scripts/deploy.py init; do not commit filled files.
PUBLIC_HOST=alumni.your-college-domain.org
PUBLIC_ORIGIN=https://alumni.your-college-domain.org
SECRETS_DIR=/secure/cmrunite/secrets
BACKUP_REPOSITORY=/separate-backup-disk/cmrunite
APP_VERSION=release-version
MONGODB_IMAGE=cmrunite-mongodb:local
MONGO_TOOLS_IMAGE=cmrunite-mongo-tools:local
EDGE_IMAGE=cmrunite-edge:local
BACKUP_IMAGE=cmrunite-backup:local
EMAIL_USER=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
PLACEMENT_JOB_EMAIL_ENABLED=false
PLACEMENT_OFFICE_EMAIL=
