    "test:e2e:rejection": "playwright test --config playwright.rejection.config.js",
    "test:e2e:super-admin": "playwright test --config playwright.super-admin.config.js",
    "test:e2e:full-project": "playwright test --config playwright.full-project.config.js"
  },
  "dependencies": {
