NODE_ENV=development
PORT=4000
DB_NAME=alumniDB
MONGODB_URI=mongodb://127.0.0.1:27017/alumniDB
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=
JWT_COOKIE_EXPIRES_IN=30
JWT_EXPIRES_IN=30m
EMAIL_USER=
EMAIL_PASS=
# Opt in after configuring sender credentials, placement recipient and FRONTEND_URL.
PLACEMENT_JOB_EMAIL_ENABLED=false
PLACEMENT_OFFICE_EMAIL=
ML_SERVICE_URL=http://127.0.0.1:5001
PUBLIC_API_URL=http://127.0.0.1:4000
FRONTEND_URL=http://127.0.0.1:5173

# Privileged accounts are provisioned with setup:super-admin, never at server startup.
# For explicit --create only, set SUPER_ADMIN_PASSWORD securely in your shell.

# Development may use JWT_SECRET for CSRF; production requires an independent secret.
CSRF_SECRET=
# Production: explicit CIDRs for the trusted reverse proxy, never true or a hop count.
TRUST_PROXY=
# Optional custom SMTP transport. Require TLS in production; Gmail fallback remains available.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_PASSWORD=
# Private monitor authentication; never expose its endpoint publicly.
MONITOR_TOKEN=
# Production supports *_FILE variants; prefer scripts/deploy.py private configuration.
